// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  DOCTOR
  PENDING_DOCTOR
  REJECTED
  BANNED
}

model User {
  id       String  @id @default(uuid())
  verified Boolean @default(false)
  email    String  @unique()
  name     String
  password String  @default("")
  role     Role    @default(USER)
  phone    String  @default("")

  doctor Doctor?
  auditlogs Auditlog[]
  notifications Notification[]
  stats UserStats?

  hide_doctor_button Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  image     String    @default("https://res.cloudinary.com/zh887hwp/image/upload/v1784712025/default-image-for-my-users.svg")
}

model Doctor {
  id String @id @default(uuid())

  user_id String @unique()
  user    User   @relation(fields: [user_id], references: [id])

  location      String
  experience    Int    @default(0)
  TotalPatients Int    @default(0)
  languages     String[]
  CompletedAppointments Int @default(0)
  rating        Float  @default(0)
  reviewCount   Int    @default(0)
  profileImage  String @default("")

  speciality     String
  bio            String
  license_number String

  medical_license_url String

  verified Boolean @default(false)
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())

  user_id   String
  user      User     @relation(fields: [user_id], references: [id])

  title     String
  message   String

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())

  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  userId    String

  rating    Int
  comment   String?

  createdAt DateTime @default(now())
}

model Auditlog {
  id        String   @id @default(uuid())

  user_id   String?
  user      User?    @relation(fields: [user_id], references: [id])

  action    String
  details   String?

  timestamp DateTime @default(now())
}

model UserStats {
  id String @id @default(uuid())

  user_id String @unique()
  user    User   @relation(fields: [user_id], references: [id])

  Appointments Int @default(0)
  completedAppointments Int @default(0)
  cancelledAppointments Int @default(0)
  pendingAppointments Int @default(0)
  Reviews Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stats {
  id String @id @default(uuid())

  TotalUsers          Int @default(0)
  TotalDoctors        Int @default(0)
  TotalAppointments   Int @default(0)
  ActiveDoctors       Int @default(0)
  PenddingAplications Int @default(0)

  ServerUptime    Float @default(0)
  activeSessions  Int   @default(0)
  apiResponseTime Float @default(0)
  totalrequests   Int   @default(0)

  PendingDoctors Int   @default(0)
  MonthlyGrowth  Float @default(0)
  SystemHealth   Float @default(0)
  ResponceTime   Float @default(0)

  NewSubmissions Int   @default(0)
  verifiedRate   Float @default(0)
}
