# Copy to .env for local/native runs: `cp .env.example .env`.
# Spring Boot doesn't read .env files by itself — DotenvLoader
# (src/main/java/com/example/demo/DotenvLoader.java) loads this into JVM
# system properties before Spring starts, so these are picked up the same
# way every other service in this project reads its own .env.
#
# When running via the root docker-compose.yml instead, these are already
# passed in as real environment variables (container DNS names, not
# localhost) and this file is ignored — a real env var always wins over
# what's in here.

PORT=8080
FRONTEND_URL=http://localhost:3000
AUTH_SERVICE_URI=http://host.docker.internal:1337
APPOINTMENT_SERVICE_URI=http://host.docker.internal:1339